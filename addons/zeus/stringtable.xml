        <Key ID="STR_hostis_Zeus_Dialog_AORadius">
            <English>Area of operations radius (m)</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_AORadius_ToolTip">
            <English>Centred where you clicked. The Director spends nothing outside it: no reinforcement, no counterattack, no fire mission. 0 removes the area.</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_Cap">
            <English>Escalation cap</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_Cap_ToolTip">
            <English>The highest level the group may climb to on its own: routine, alert, engaged, decisive.</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_Error">
            <English>Target error (m)</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_Error_ToolTip">
            <English>How well the gun is told where to shoot. The Director adjusts from this circle.</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_FireMissions">
            <English>Fire missions left</English>
        </Key>
        <Key ID="STR_hostis_Zeus_Dialog_FireMissions_ToolTip">
